---
import { siteConfig } from '@data/config';

interface Props {
    variant?: 'header' | 'footer' | 'dark';
}

const { variant = 'header' } = Astro.props;

// Determine the logo size based on variant
const getLogoHeight = () => {
    switch (variant) {
        case 'header':
            return 'h-12'; // 48px for header
        case 'footer':
            return 'h-10'; // 40px for footer
        case 'dark':
            return 'h-12';
        default:
            return 'h-12';
    }
};
---

<a href="/" class="logo transition-opacity duration-200 hover:opacity-80 flex items-center gap-2">
    <img
        src="/logo-geb.png"
        alt={siteConfig.companyName}
        class:list={['w-auto', getLogoHeight()]}
    />
    <span class="font-bold text-lg hidden sm:inline-block">{siteConfig.companyName}</span>
</a>
