---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import Features from '@components/sections/Features.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import RecentPosts from '@components/sections/RecentPosts.astro';
import { getCollection, getEntry } from 'astro:content';
import { getIcon } from '@utils/iconMap';
import heroImage from '../assets/images/home/default-hero-geb.png';

// Fetch homepage configuration
const homepageData = await getEntry('homepage', 'index');
if (!homepageData) {
    throw new Error('Homepage configuration not found');
}

const { hero, features, mainCta, footerCta, recentPosts, seo } = homepageData.data;

// Fetch all features and filter active ones, sorted by order
const allFeatures = await getCollection('feature');
const activeFeatures = allFeatures
    .filter(feature => feature.data.active)
    .sort((a, b) => a.data.order - b.data.order)
    .map(feature => ({
        icon: getIcon(feature.data.icon),
        title: feature.data.title,
        description: feature.data.description,
    }));

// SEO configuration
const seoTitle = seo.seoTitle;
const seoDescription = seo.seoDescription;

// Hero section configuration
const heroContent = {
    title: hero.heroTitle,
    description: hero.heroDescription,
    buttons: [
        {
            text: hero.heroButton1Text,
            link: hero.heroButton1Link,
            target: '_self'
        },
        {
            text: hero.heroButton2Text,
            link: hero.heroButton2Link,
            target: '_self'
        }
    ],
    backgroundImage: hero.heroImage || heroImage,
    overlayOpacity: hero.heroOverlayOpacity
};

// Features section configuration
const featuresSection = {
    eyebrow: features.featuresEyebrow,
    title: features.featuresTitle,
    description: features.featuresDescription,
    features: activeFeatures,
    button: {
        text: features.featuresButtonText,
        link: features.featuresButtonLink,
        variant: "primary" as const
    }
};

// Footer CTA configuration
const FooterCta = {
    eyebrow: footerCta.footerCtaEyebrow,
    title: footerCta.footerCtaTitle,
    description: footerCta.footerCtaDescription,
    hideCta: false,
    button: {
        text: footerCta.footerCtaButtonText,
        link: footerCta.footerCtaButtonLink,
        target: '_self'
    }
};

// Main CTA configuration
const mainCtaConfig = {
    eyebrow: mainCta.mainCtaEyebrow,
    title: mainCta.mainCtaTitle,
    description: mainCta.mainCtaDescription,
    button: {
        text: mainCta.mainCtaButtonText,
        link: mainCta.mainCtaButtonLink,
        variant: "primary" as const,
        target: "_self" as const
    }
};

// Recent posts section configuration
const recentPostsSection = {
    eyebrow: recentPosts.recentPostsEyebrow,
    title: recentPosts.recentPostsTitle,
    description: recentPosts.recentPostsDescription,
    button: {
        text: recentPosts.recentPostsButtonText,
        link: recentPosts.recentPostsButtonLink,
        variant: "primary" as const
    }
};
---

<Layout footerCta={FooterCta} title={seoTitle} description={seoDescription}>
    <Hero content={heroContent} />
    <RecentPosts content={recentPostsSection} background="base" padding="base" postsToShow={recentPosts.recentPostsCount} />
    <Features content={featuresSection} padding="base" background="light" />
    <CtaBanner content={mainCtaConfig} variant="contained" background="light" paddingBottom="base" />
</Layout>
