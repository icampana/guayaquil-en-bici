---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/sections/Hero.astro';
import SplitPanel from '@components/sections/SplitPanel.astro';
import Features from '@components/sections/Features.astro';
import Stats from '@components/sections/Stats.astro';
import { featureLists } from '@data/features';
import { statsLists } from '@data/stats';
import Logos from '@components/sections/Logos.astro';
import { logoLists } from '@data/logos';
import CtaBanner from '@components/sections/CtaBanner.astro';
import Faqs from '@components/sections/Faqs.astro';
import { faqLists } from '@data/faqs';
import RecentPosts from '@components/sections/RecentPosts.astro';
import heroImage from '../assets/images/home/default-hero-2.jpg';
import styleGuideImage from '../assets/images/home/developer.jpg';

const seoTitle = "Guayaquil en Bici - Movilidad Sostenible";
const seoDescription = "Colectivo ciudadano que promueve el uso de la bicicleta como medio de transporte sostenible en Guayaquil, Ecuador.";

const heroContent = {
    title: 'Pedaleando Hacia una Ciudad Más Sostenible',
    description: 'Somos un colectivo ciudadano dedicado a promover el ciclismo urbano como medio de transporte sostenible, seguro y accesible en Guayaquil. Únete a nosotros para construir una ciudad más amigable con las bicicletas.',
    buttons: [
        {
            text: 'Conócenos',
            link: '/que-hacemos',
            target: '_self'
        },
        {
            text: 'Contáctanos',
            link: '/contactanos',
            target: '_self'
        }
    ],
    backgroundImage: heroImage,
    overlayOpacity: 0.3
}

const featuresSection = {
    eyebrow: "¿QUÉ HACEMOS?",
    title: "Promoviendo el Ciclismo Urbano en Guayaquil",
    description: "Trabajamos en múltiples frentes para hacer de Guayaquil una ciudad más amigable con las bicicletas, promoviendo la movilidad sostenible y el derecho a circular en condiciones dignas y seguras.",
    features: featureLists.main.features,
    button: {
        text: "Conoce Más Sobre Nosotros",
        link: "/que-hacemos",
        variant: "primary" as const
    }
}

const FooterCta = {
    eyebrow: "Únete al Movimiento",
    title: 'Sé Parte del Cambio en Guayaquil',
    description: 'Todos somos bienvenidos en Guayaquil en Bici. Únete a nuestras actividades, comparte tus experiencias y ayúdanos a construir una ciudad más sostenible para todos.',
    hideCta: false,
    button: {
        text: 'Contáctanos',
        link: '/contactanos',
        target: '_self'
    }
}

const styleGuideSection = {
    eyebrow: "Design System",
    headline: "Consistent & Beautiful Components",
    description: "Titan Core comes with a complete style guide to ensure your projects maintain visual consistency. From typography to interactive elements, we've carefully crafted each component.",
    image: {
        src: styleGuideImage,
        alt: "Featured image"
    },
    buttons: [
        {
            text: "Explore Style Guide",
            link: "/style-guide",
            variant: "primary" as const
        }
    ]
}

const sideBySideStats = {
    eyebrow: "Stats",
    title: "Built for Speed and Flexibility",
    description: "Titan Core is designed with performance and developer experience in mind. Our lightweight theme gives you all the essentials without the bloat, letting you build exactly what you need with impressive speed.",
    variant: 'side-by-side' as const,
    stats: statsLists.withContent.stats,
    content: {
        title: "Built for Speed and Flexibility",
        description: "Titan Core is designed with performance and developer experience in mind. Our lightweight theme gives you all the essentials without the bloat, letting you build exactly what you need with impressive speed.",
        button: {
            text: "Discover Titan Core",
            link: "/theme-info",
            variant: "primary" as const
        }
    }
};

const mainCta = {
    eyebrow: "Nuestras Actividades",
    title: "Participa en Nuestros Eventos",
    description: "Únete a la Masa Crítica, el Día Mundial Sin Auto, Alleycat y más eventos que organizamos para promover el ciclismo urbano en Guayaquil. ¡Todos son bienvenidos!",
    button: {
        text: "Ver Actividades",
        link: "/masa-critica",
        variant: "primary" as const,
        target: "_self" as const
    }
};


const logosSection = {
    eyebrow: "Our Clients",
    logos: logoLists.main.logos
}

const faqsSection = {
    eyebrow: "FAQs",
    title: 'Frequently Asked Questions',
    description: 'Find answers to common questions about our platform and services.',
    faqs: faqLists.main.faqs
}

const recentPostsSection = {
    eyebrow: "ÚLTIMAS NOTICIAS",
    title: "Lo Más Reciente del Ciclismo Urbano",
    description: "Mantente informado sobre las últimas noticias, eventos y actividades relacionadas con el ciclismo urbano en Guayaquil y más allá.",
    button: {
            text: "Ver Todas las Publicaciones",
            link: "/blog",
        variant: "primary" as const
    }
}
---

<Layout footerCta={FooterCta} title={seoTitle} description={seoDescription}>
    <Hero content={heroContent} />
    <RecentPosts content={recentPostsSection} background="base" padding="base" postsToShow={6} />
    <Features content={featuresSection} padding="base" background="light" />
    <CtaBanner content={mainCta} variant="contained" background="light" paddingBottom="base" />
</Layout>